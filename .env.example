# Copy to .env.local for local development (`vercel dev`), and add the same
# variables in Vercel → Project → Settings → Environment Variables.
# NEVER commit real secrets. Only VITE_* variables reach the browser.

# ── Public (browser) ─────────────────────────────────────────────
# Your live site URL, no trailing slash. Used for canonical and share links.
VITE_SITE_URL=https://www.your-domain.com

# ── Supabase (server only) ───────────────────────────────────────
# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key. Server only — never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Razorpay (server only) ───────────────────────────────────────
# Razorpay Dashboard → Account & Settings → API Keys.
# Use rzp_test_ keys while testing, rzp_live_ keys in production.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Razorpay Dashboard → Webhooks → the secret you set for /api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── Email (optional, server only) ────────────────────────────────
# Confirmation emails via Resend (https://resend.com). Leave blank to skip emails;
# bookings still work and show the reference on screen.
RESEND_API_KEY=
# A sender on a domain you have verified in Resend, e.g. "STARPEAK Media <hello@your-domain.com>"
EMAIL_FROM=
# Where new inquiry / booking notifications are sent (your inbox).
STUDIO_NOTIFY_EMAIL=

# Your live site URL (server side), no trailing slash.
SITE_URL=https://www.your-domain.com
